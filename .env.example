# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pareed

# JWT Secret for Authentication
JWT_SECRET=pareed_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL (For CORS setup)
CLIENT_URL=http://localhost:5173
